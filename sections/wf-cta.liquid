{%- liquid
  assign s = section.settings
-%}
<div
  id="WfCta-{{ section.id }}"
  class="wf wf-cta wf--{{ s.tone }}"
  style="--wf-pt: {{ s.padding_top }}px; --wf-pb: {{ s.padding_bottom }}px;"
>
  {%- render 'wf-decor', left: s.decor_left, right: s.decor_right, width: s.decor_width, position: s.decor_position -%}
  <div class="wf-container">
    {%- render 'wf-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text, tag: s.heading_tag, size: 'md', class: 'wf-head--center' -%}
    {%- if s.button_label != blank or s.secondary_label != blank -%}
      <div class="wf-actions wf-actions--center">
        {%- render 'wf-button', label: s.button_label, url: s.button_url -%}
        {%- render 'wf-button', label: s.secondary_label, url: s.secondary_url, style: 'outline' -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "WF | Call to Action",
  "class": "wf-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Press Enter to start a new line."
    },
    {
      "type": "textarea",
      "id": "heading_accent",
      "label": "Heading, teal line",
      "info": "Shown in teal on its own line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1 (page title)"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "info": "Use H1 once per page, in the first section."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "tint",
          "label": "Soft aqua tint"
        },
        {
          "value": "aqua",
          "label": "Pale aqua band"
        }
      ],
      "default": "tint"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Corner decoration",
      "info": "Leaves or water splash. Shown on desktop only."
    },
    {
      "type": "image_picker",
      "id": "decor_left",
      "label": "Left decoration"
    },
    {
      "type": "image_picker",
      "id": "decor_right",
      "label": "Right decoration"
    },
    {
      "type": "range",
      "id": "decor_width",
      "label": "Decoration width",
      "min": 120,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "select",
      "id": "decor_position",
      "label": "Decoration position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    }
  ],
  "presets": [
    {
      "name": "WF | Call to Action",
      "category": "Water Flush"
    }
  ]
}
{% endschema %}
