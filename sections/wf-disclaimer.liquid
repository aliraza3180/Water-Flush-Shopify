{%- liquid
  assign s = section.settings
-%}
{%- if s.disclaimer != blank -%}
  <div
    id="WfDisclaimer-{{ section.id }}"
    class="wf wf-disclaimer wf--{{ s.tone }}"
    style="--wf-pt: {{ s.padding_top }}px; --wf-pb: {{ s.padding_bottom }}px;"
    role="note"
    aria-label="{{ s.label | escape }}"
  >
    <div class="wf-container">
      <div class="wf-disclaimer__box">
        <p>{{ s.disclaimer | escape }}</p>
        {%- if s.note != blank -%}
          <p>{{ s.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "WF | FDA Disclaimer",
  "class": "wf-section",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown on every page when placed in the footer group. The first line is the dietary supplement disclaimer required alongside claims marked with an asterisk. Do not reword it."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Dietary supplement disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Second line"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "tint",
          "label": "Soft aqua tint"
        },
        {
          "value": "aqua",
          "label": "Pale aqua band"
        }
      ],
      "default": "white"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "WF | FDA Disclaimer",
      "category": "Water Flush"
    }
  ]
}
{% endschema %}
