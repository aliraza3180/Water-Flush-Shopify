{%- liquid
  assign s = section.settings
  assign checks = section.blocks | where: 'type', 'check'
  assign rows = section.blocks | where: 'type', 'icon_row'
  assign chips = section.blocks | where: 'type', 'chip'
  assign has_list = false
  if checks.size > 0 or rows.size > 0
    assign has_list = true
  endif
-%}
{%- capture list -%}
  {%- if rows.size > 0 -%}
    <ul class="wf-rows" role="list">
      {%- for block in rows -%}
        <li class="wf-rows__item" {{ block.shopify_attributes }}>
          <span class="wf-chip wf-chip--sm">{%- render 'wf-icon', name: block.settings.icon -%}</span>
          <span class="wf-rows__body">
            <strong class="wf-rows__title">{{ block.settings.title | escape }}</strong>
            {%- if block.settings.text != blank -%}
              <span class="wf-rows__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if checks.size > 0 -%}
    <ul class="wf-checks" role="list">
      {%- for block in checks -%}
        <li class="wf-checks__item" {{ block.shopify_attributes }}>
          {%- render 'wf-icon', name: 'check-circle' -%}
          <span class="wf-checks__body">
            {%- if block.settings.title != blank -%}
              <strong class="wf-checks__title">{{ block.settings.title | escape }}</strong>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="wf-checks__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}
<div
  id="WfSplit-{{ section.id }}"
  class="wf wf-split wf--{{ s.tone }} wf-split--{{ s.layout }} wf-split--media-{{ s.media_side }} wf-split--shape-{{ s.media_shape }}{% if s.image == blank %} wf-split--no-image{% endif %}"
  style="--wf-pt: {{ s.padding_top }}px; --wf-pb: {{ s.padding_bottom }}px; --wf-fade: {{ s.fade | divided_by: 100.0 }};"
>
  {%- render 'wf-decor', left: s.decor_left, right: s.decor_right, width: s.decor_width, position: s.decor_position -%}
  {%- if s.layout != 'columns' -%}
    <div class="wf-split__media">
      {%- render 'wf-image', image: s.image, image_mobile: s.image_mobile, alt: s.image_alt, class: 'wf-split__image', label: 'Image, 1600 x 1400 px' -%}
      {%- if s.script_text != blank -%}
        <p class="wf-script">{{ s.script_text | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="wf-container wf-split__inner">
    <div class="wf-split__content">
      {%- if s.show_seal -%}
        <div class="wf-seal" role="img" aria-label="{{ s.seal_top | escape }} {{ s.seal_bottom | escape }}">
          <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
            <defs>
              <path id="WfSealTop-{{ section.id }}" d="M 18 60 A 42 42 0 0 1 102 60"/>
              <path id="WfSealBottom-{{ section.id }}" d="M 14 60 A 46 46 0 0 0 106 60"/>
            </defs>
            <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="60" cy="60" r="27" fill="none" stroke="currentColor" stroke-width="1.500"/>
            <path d="M48 60.500l8.500 8.500L73 51.500" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            <text class="wf-seal__text"><textPath href="#WfSealTop-{{ section.id }}" startOffset="50%" text-anchor="middle">{{ s.seal_top | escape }}</textPath></text>
            <text class="wf-seal__text"><textPath href="#WfSealBottom-{{ section.id }}" startOffset="50%" text-anchor="middle">{{ s.seal_bottom | escape }}</textPath></text>
          </svg>
        </div>
      {%- endif -%}
      {%- render 'wf-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, text: s.text, tag: s.heading_tag, size: 'lg' -%}
      {%- if s.layout != 'columns' -%}
        {{ list }}
      {%- endif -%}
      {%- if chips.size > 0 -%}
        <ul class="wf-chips wf-chips--inline" role="list" style="--wf-cols: {{ chips.size }};">
          {%- for block in chips -%}
            <li class="wf-chips__item" {{ block.shopify_attributes }}>
              <span class="wf-chip">{%- render 'wf-icon', name: block.settings.icon -%}</span>
              <span class="wf-chips__label">{{ block.settings.text | escape | newline_to_br }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="wf-actions">
          {%- render 'wf-button', label: s.button_label, url: s.button_url -%}
          {%- if s.link_label != blank and s.link_url != blank -%}
            <a class="wf-link" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if s.layout == 'columns' -%}
      {%- if s.image != blank or request.design_mode -%}
        <div class="wf-split__figure">
          {%- render 'wf-image', image: s.image, alt: s.image_alt, sizes: '(min-width: 990px) 30vw, 70vw', class: 'wf-split__image', label: 'Image, 1200 x 1200 px' -%}
        </div>
      {%- endif -%}
      {%- if has_list -%}
        <div class="wf-split__list">{{ list }}</div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
