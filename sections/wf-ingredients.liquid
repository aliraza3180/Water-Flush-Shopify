{%- liquid
  assign s = section.settings
-%}
<div
  id="WfIngredients-{{ section.id }}"
  class="wf wf-ing wf--{{ s.tone }} wf-ing--{{ s.style }}"
  style="--wf-pt: {{ s.padding_top }}px; --wf-pb: {{ s.padding_bottom }}px; --wf-cols: {{ s.columns }};"
>
  {%- render 'wf-decor', left: s.decor_left, right: s.decor_right, width: s.decor_width, position: s.decor_position -%}
  <div class="wf-container">
    {%- render 'wf-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, text: s.text, tag: s.heading_tag, size: 'md', class: 'wf-head--center' -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="wf-ing__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign badges = b.badges | split: ','
          -%}
          <li class="wf-ing__item" {{ block.shopify_attributes }}>
            {%- if b.image == blank and badges.size > 0 -%}
              <div class="wf-ing__badges" aria-hidden="true">
                {%- for badge in badges -%}
                  <span class="wf-ing__badge wf-ing__badge--{{ forloop.index }}">{{ badge | strip | escape }}</span>
                {%- endfor -%}
              </div>
            {%- else -%}
              {%- render 'wf-image', image: b.image, alt: b.image_alt, sizes: '(min-width: 990px) 16vw, (min-width: 750px) 30vw, 45vw', class: 'wf-ing__image', label: 'Ingredient, 800 x 800 px' -%}
            {%- endif -%}
            <h3 class="wf-ing__name">{{ b.name | escape }}</h3>
            {%- if b.text != blank and s.style == 'cards' -%}
              <div class="wf-ing__text rte">{{ b.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="wf-actions wf-actions--center">
        {%- render 'wf-button', label: s.button_label, url: s.button_url -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "WF | Ingredients",
  "class": "wf-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "cutouts",
          "label": "Images with names"
        },
        {
          "value": "cards",
          "label": "Cards with descriptions"
        }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Press Enter to start a new line."
    },
    {
      "type": "textarea",
      "id": "heading_accent",
      "label": "Heading, teal line",
      "info": "Shown in teal on its own line."
    },
    {
      "type": "textarea",
      "id": "heading_end",
      "label": "Heading, line after the teal one"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1 (page title)"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "info": "Use H1 once per page, in the first section."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "tint",
          "label": "Soft aqua tint"
        },
        {
          "value": "aqua",
          "label": "Pale aqua band"
        }
      ],
      "default": "white"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Corner decoration",
      "info": "Leaves or water splash. Shown on desktop only."
    },
    {
      "type": "image_picker",
      "id": "decor_left",
      "label": "Left decoration"
    },
    {
      "type": "image_picker",
      "id": "decor_right",
      "label": "Right decoration"
    },
    {
      "type": "range",
      "id": "decor_width",
      "label": "Decoration width",
      "min": 120,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "select",
      "id": "decor_position",
      "label": "Decoration position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "800 x 800 px on a white background."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description (alt text)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Ingredient"
        },
        {
          "type": "text",
          "id": "badges",
          "label": "Letter badges instead of an image",
          "info": "Comma separated, for example: B6, K, Cl. Used when no image is chosen."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WF | Ingredients",
      "category": "Water Flush"
    }
  ]
}
{% endschema %}
