{%- liquid
  assign s = section.settings
  assign product = s.product
  assign options = section.blocks | where: 'type', 'option'
  assign assurances = section.blocks | where: 'type', 'assurance'
  assign title_tag = 'h3'
  if s.heading == blank and s.heading_accent == blank and s.heading_end == blank
    assign title_tag = 'h2'
  endif
  assign anchor = 'WfSizes-' | append: section.id
  if s.anchor != blank
    assign anchor = s.anchor | handle
  endif
-%}
<div
  id="{{ anchor }}"
  class="wf wf-sizes wf--{{ s.tone }} wf-sizes--{{ s.layout }}{% if s.background != blank %} wf-sizes--bg{% endif %}"
  style="--wf-pt: {{ s.padding_top }}px; --wf-pb: {{ s.padding_bottom }}px; --wf-cols: {{ options.size | at_least: 1 }};"
>
  {%- if s.background != blank -%}
    <div class="wf-sizes__bg" aria-hidden="true">
      {{ s.background | image_url: width: 2400 | image_tag: widths: '750, 1280, 1600, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}
    </div>
  {%- endif -%}
  {%- render 'wf-decor', left: s.decor_left, right: s.decor_right, width: s.decor_width, position: s.decor_position -%}
  <div class="wf-container wf-sizes__inner">
    {%- if s.heading != blank or s.heading_accent != blank or s.eyebrow != blank or s.text != blank -%}
      {%- render 'wf-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, text: s.text, tag: s.heading_tag, size: 'lg', class: 'wf-sizes__head' -%}
    {%- endif -%}
    <ul class="wf-sizes__cards" role="list">
      {%- for block in options -%}
        {%- liquid
          assign b = block.settings
          assign index = b.variant_position | minus: 1
          assign variant = product.variants[index]
          assign title = b.title | default: variant.title
          assign image = b.image | default: variant.featured_image | default: product.featured_image
          assign form_id = 'WfBuy-' | append: section.id | append: '-' | append: forloop.index
          assign check_lines = b.checks | newline_to_br | split: '<br />'
        -%}
        <li class="wf-size{% if b.badge != blank %} wf-size--badged{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}
            <p class="wf-size__badge">{{ b.badge | escape }}</p>
          {%- endif -%}
          <div class="wf-size__card">
            <div class="wf-size__media">
              {%- render 'wf-image', image: image, alt: b.image_alt, sizes: '(min-width: 990px) 16vw, 45vw', class: 'wf-size__image', label: 'Bottle image' -%}
            </div>
            <div class="wf-size__body">
              <{{ title_tag }} class="wf-size__title">{{ title | escape }}</{{ title_tag }}>
              {%- if b.text != blank -%}
                <p class="wf-size__text">{{ b.text | escape }}</p>
              {%- endif -%}
              <p class="wf-size__price">
                <span class="visually-hidden">Price:</span>
                {%- if variant -%}
                  {%- if variant.compare_at_price > variant.price -%}
                    <s class="wf-size__compare"><span class="visually-hidden">Regular price</span> {{ variant.compare_at_price | money }}</s>
                  {%- endif -%}
                  {{ variant.price | money }}
                {%- else -%}
                  {{ s.price_pending_text | escape }}
                {%- endif -%}
              </p>
              {%- if check_lines.size > 0 and b.checks != blank -%}
                <ul class="wf-size__checks" role="list">
                  {%- for line in check_lines -%}
                    {%- assign line_text = line | strip -%}
                    {%- if line_text != blank -%}
                      <li>{%- render 'wf-icon', name: 'check-circle' -%}<span>{{ line_text | escape }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <div class="wf-size__buy">
                {%- if s.button_mode == 'cart' and variant -%}
                  {%- render 'wf-buy', product: product, variant: variant, form_id: form_id, section_id: section.id, label: s.button_label, show_quantity: s.show_quantity -%}
                {%- else -%}
                  {%- render 'wf-button', label: s.button_label, url: s.button_url, class: 'wf-btn--full' -%}
                {%- endif -%}
              </div>
              {%- if assurances.size > 0 -%}
                <ul class="wf-size__assurances" role="list">
                  {%- for item in assurances -%}
                    <li>
                      {%- render 'wf-icon', name: item.settings.icon -%}
                      {%- if item.settings.link != blank -%}
                        <a href="{{ item.settings.link }}">{{ item.settings.text | escape }}</a>
                      {%- else -%}
                        <span>{{ item.settings.text | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if s.details_label != blank and product != blank and variant -%}
                <a class="wf-link wf-size__details" href="{{ variant.url }}">
                  {{- s.details_label | escape -}}
                  <span class="visually-hidden">: {{ title | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- if s.button_mode == 'cart' and product != blank -%}
  {%- render 'add-to-cart-button-styles' -%}
  {%- render 'buy-buttons-styles' -%}
  {%- render 'fly-to-cart-styles' -%}
{%- endif -%}

{% schema %}
{
  "name": "WF | Size Selector",
  "class": "wf-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 9,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Prices and availability come from the product."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "side",
          "label": "Text left, cards right"
        },
        {
          "value": "wide",
          "label": "Wide cards, bottle beside the details"
        }
      ],
      "default": "side"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Press Enter to start a new line."
    },
    {
      "type": "textarea",
      "id": "heading_accent",
      "label": "Heading, teal line",
      "info": "Shown in teal on its own line."
    },
    {
      "type": "textarea",
      "id": "heading_end",
      "label": "Heading, line after the teal one"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1 (page title)"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2",
      "info": "Use H1 once per page, in the first section."
    },
    {
      "type": "header",
      "content": "Card button"
    },
    {
      "type": "select",
      "id": "button_mode",
      "label": "Button action",
      "options": [
        {
          "value": "cart",
          "label": "Add to cart"
        },
        {
          "value": "link",
          "label": "Link"
        }
      ],
      "default": "cart"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Used when the action is \"Link\"."
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity buttons",
      "default": false
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Product page link label",
      "info": "Leave empty to hide the link."
    },
    {
      "type": "text",
      "id": "price_pending_text",
      "label": "Text shown when there is no price",
      "default": "$XX.XX"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor name",
      "info": "Lets buttons jump here, for example \"shop\" for a link ending in #shop."
    },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background image",
      "info": "2400 x 1000 px, pale water."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "tint",
          "label": "Soft aqua tint"
        },
        {
          "value": "aqua",
          "label": "Pale aqua band"
        }
      ],
      "default": "tint"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Corner decoration",
      "info": "Leaves or water splash. Shown on desktop only."
    },
    {
      "type": "image_picker",
      "id": "decor_left",
      "label": "Left decoration"
    },
    {
      "type": "image_picker",
      "id": "decor_right",
      "label": "Right decoration"
    },
    {
      "type": "range",
      "id": "decor_width",
      "label": "Decoration width",
      "min": 120,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "select",
      "id": "decor_position",
      "label": "Decoration position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Size card",
      "settings": [
        {
          "type": "range",
          "id": "variant_position",
          "label": "Size (position in the product)",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the size name."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "For example: Best Value"
        },
        {
          "type": "textarea",
          "id": "checks",
          "label": "Checklist",
          "info": "One line per item."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the image of the size."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description (alt text)"
        }
      ]
    },
    {
      "type": "assurance",
      "name": "Reassurance line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "lotus",
              "label": "Lotus"
            },
            {
              "value": "body",
              "label": "Body"
            },
            {
              "value": "bolt",
              "label": "Bolt"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "cycle",
              "label": "Cycle"
            },
            {
              "value": "flask",
              "label": "Flask"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "check-circle",
              "label": "Check circle"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "capsule",
              "label": "Capsule"
            },
            {
              "value": "mail",
              "label": "Mail"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free U.S. Shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WF | Size Selector",
      "category": "Water Flush"
    }
  ]
}
{% endschema %}
