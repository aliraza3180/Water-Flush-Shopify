{%- doc -%}
  Inline line icons for the "WF |" sections.

  @param {string} name - Icon name (see the list in the case statement)

  @example
  {% render 'wf-icon', name: 'leaf' %}
{%- enddoc -%}
{%- if name != blank and name != 'none' -%}
  <svg class="wf-icon wf-icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'drop' -%}
        <path d="M12 3.5c3.200 3.600 6 6.900 6 10.200a6 6 0 0 1-12 0c0-3.300 2.800-6.600 6-10.200z"/><path d="M9.300 14.500a2.800 2.800 0 0 0 2.300 2.600"/>
      {%- when 'leaf' -%}
        <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c2-5 5-8 9-10"/>
      {%- when 'lotus' -%}
        <path d="M12 5c2.200 2.400 3.200 5 3.200 7.500S14 17.300 12 19c-2-1.700-3.200-4-3.200-6.500S9.800 7.400 12 5z"/><path d="M8.900 11.300C7 9.900 5 9.500 3 9.800c.200 3.600 1.900 6.500 5 8 1.300.600 2.600 1 4 1.200"/><path d="M15.100 11.300c1.900-1.400 3.900-1.800 5.900-1.500-.200 3.600-1.900 6.500-5 8-1.300.600-2.600 1-4 1.200"/>
      {%- when 'body' -%}
        <path d="M8 3c.400 3.200-.800 5.400-.800 8.200 0 2.600 1 4.600.800 9.800"/><path d="M16 3c-.400 3.200.800 5.400.800 8.200 0 2.600-1 4.600-.800 9.800"/><path d="M8.600 15.500c2.200 1.200 4.600 1.200 6.800 0"/><path d="M4 12h2M18 12h2"/>
      {%- when 'bolt' -%}
        <path d="M13.500 3L5.500 13.500h5.500L10 21l8.500-11h-5.500z"/>
      {%- when 'heart' -%}
        <path d="M12 20s-7-4.300-7-9.700A3.800 3.800 0 0 1 12 8a3.800 3.800 0 0 1 7 2.300c0 5.400-7 9.700-7 9.700z"/>
      {%- when 'cycle' -%}
        <path d="M19.500 12a7.500 7.500 0 0 1-13 5.100"/><path d="M4.500 12a7.500 7.500 0 0 1 13-5.100"/><path d="M17.800 3.500v3.600h-3.600"/><path d="M6.200 20.500v-3.600h3.600"/>
      {%- when 'flask' -%}
        <path d="M9.500 3h5"/><path d="M10.500 3v6.200L5.200 18a2 2 0 0 0 1.700 3h10.200a2 2 0 0 0 1.700-3l-5.300-8.800V3"/><path d="M7.800 15h8.400"/>
      {%- when 'shield' -%}
        <path d="M12 3l7 2.800v5.400c0 4.300-2.900 7.600-7 9.300-4.100-1.700-7-5-7-9.300V5.800z"/><path d="M9 12l2.200 2.200L15.200 10"/>
      {%- when 'check-circle' -%}
        <circle cx="12" cy="12" r="9"/><path d="M8 12.300l2.800 2.800L16.200 9.500"/>
      {%- when 'check' -%}
        <path d="M5 12.500l4.500 4.500L19 7.500"/>
      {%- when 'award' -%}
        <circle cx="12" cy="9.500" r="6"/><path d="M8.500 14.500L7 21l5-2.500 5 2.500-1.500-6.500"/><path d="M9.700 9.700l1.600 1.600 3-3.200"/>
      {%- when 'star' -%}
        <path d="M12 3.500l2.600 5.300 5.900.900-4.300 4.100 1 5.800-5.200-2.700-5.200 2.700 1-5.800-4.300-4.100 5.900-.900z"/>
      {%- when 'truck' -%}
        <path d="M2.500 6.500h11v9.500h-11z"/><path d="M13.500 10h4.200l3.300 3.300V16h-7.500"/><circle cx="7" cy="17.500" r="1.800"/><circle cx="17" cy="17.500" r="1.800"/>
      {%- when 'lock' -%}
        <rect x="5" y="10.500" width="14" height="10" rx="2"/><path d="M8 10.500V8a4 4 0 0 1 8 0v2.500"/><path d="M12 14.500v2"/>
      {%- when 'card' -%}
        <rect x="3" y="5.500" width="18" height="13" rx="2"/><path d="M3 10h18M7 14.500h4"/>
      {%- when 'capsule' -%}
        <rect x="3.200" y="8.200" width="17.600" height="7.600" rx="3.800" transform="rotate(-45 12 12)"/><path d="M9.300 9.300l5.400 5.400"/>
      {%- when 'mail' -%}
        <rect x="3" y="5.500" width="18" height="13" rx="2"/><path d="M3.500 7l8.500 6.500L20.500 7"/>
      {%- when 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
      {%- when 'minus' -%}
        <path d="M5 12h14"/>
      {%- when 'arrow' -%}
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
