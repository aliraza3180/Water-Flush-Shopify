    "wf_faq": {
      "type": "wf-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How do I take Brand Name Water Flush?",
            "answer": "<p>Take 1 capsule 1 to 2 times daily, preferably with meals, or as directed by a healthcare professional. Follow the directions printed on your bottle.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How long does each bottle last?",
            "answer": "<p>At one capsule per day, 60 capsules last about 60 days and 120 capsules about 120 days. At two capsules per day, they last about 30 and 60 days.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Is Water Flush vegan or vegetarian?",
            "answer": "<p>No. The capsule is made with bovine gelatin, so Water Flush is not vegetarian or vegan.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Who should consult a healthcare professional before using it?",
            "answer": "<p>Do not exceed recommended dose. Pregnant or nursing mothers, children under 18, and individuals with a known medical condition should consult a physician before using this or any dietary supplement. If you take medication, especially medication that affects fluid balance, blood pressure, or potassium, check with a healthcare professional first.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How much is shipping?",
            "answer": "<p>Shipping is free on all orders placed through our website within the United States, with no minimum purchase. See our <a href=\"/pages/shipping-policy\">Shipping Policy</a>.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What is your satisfaction guarantee?",
            "answer": "<p>We stand behind our products with a 30-day satisfaction guarantee. It applies to your first purchase of a product and is limited to one refund per customer or household. See the <a href=\"/pages/satisfaction-guarantee\">30-Day Satisfaction Guarantee</a> page for how to request it.</p>"
          }
        }
      },
      "block_order": [
